<?xml version="1.0" encoding="utf-8"?>
<Page x:Name="PageRoot" x:Class="BombiHighSchool.App.Views.SubjectsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid MaxWidth="1400" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3"><TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Create and maintain the subject catalogue." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                    <Border Height="1" Background="{StaticResource SurfaceBorderBrush}"/>
                    <TextBox Header="Subject name *" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" PlaceholderText="e.g. Mathematics"/>
                    <TextBox Header="Subject code *" Text="{x:Bind ViewModel.Code, Mode=TwoWay}" PlaceholderText="e.g. MTH"/>
                    <ComboBox Header="Department" ItemsSource="{x:Bind ViewModel.Departments}" SelectedItem="{x:Bind ViewModel.Department, Mode=TwoWay}"/>
                    <CheckBox Content="Compulsory subject" IsChecked="{x:Bind ViewModel.IsCompulsory, Mode=TwoWay}"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="{x:Bind ViewModel.SaveText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3"><TextBlock Text="Subjects" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Manage the curriculum catalogue available to the school." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
                    <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="Curriculum catalogue" Message="Select a subject to edit it. Delete only when you are certain it is no longer needed."/>
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}">
                        <ListView.Header>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="CODE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="SUBJECT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="DEPARTMENT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="3" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Border>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Department}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.EditCommand}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Edit subject"><SymbolIcon Symbol="Edit"/></Button>
                                        <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.DeleteCommand}" CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}" ToolTipService.ToolTip="Delete subject"><SymbolIcon Symbol="Delete"/></Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
