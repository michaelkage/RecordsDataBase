<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.StudentResultsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><ScrollViewer Padding="32"><StackPanel Spacing="18" MaxWidth="1100"><TextBlock Text="My Results" FontSize="30" FontWeight="SemiBold"/><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#172033" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Overall average" Foreground="#94A3B8"/><TextBlock Text="{x:Bind ViewModel.AverageText, Mode=OneWay}" FontSize="26" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="#172033" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Class position" Foreground="#94A3B8"/><TextBlock Text="{x:Bind ViewModel.ClassPositionText, Mode=OneWay}" FontSize="26" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="2" Background="#172033" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Department position" Foreground="#94A3B8"/><TextBlock Text="{x:Bind ViewModel.DepartmentPositionText, Mode=OneWay}" FontSize="26" FontWeight="Bold"/></StackPanel></Border></Grid><Border Background="#172033" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Subject results" FontSize="20" FontWeight="SemiBold"/><ListView ItemsSource="{x:Bind ViewModel.Scores, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding SubjectName}"/><TextBlock Grid.Column="1" Text="{Binding ContinuousAssessment}"/><TextBlock Grid.Column="2" Text="{Binding Exam}"/><TextBlock Grid.Column="3" Text="{Binding Total}" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="{Binding Grade}" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8"/></StackPanel></ScrollViewer></Page>
