<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="BombiHighSchool.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:BombiHighSchool_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E1E1E1" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#777777" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E5F1FB" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#303030" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#383838" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#444444" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8AD9FF" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#19384A" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F5C76A" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#00324A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="InsetStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
                <Setter Property="Padding" Value="32,28,32,40" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
