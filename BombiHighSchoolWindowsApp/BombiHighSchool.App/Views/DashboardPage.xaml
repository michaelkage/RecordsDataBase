<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
<ScrollViewer Padding="32,28,32,40"><StackPanel MaxWidth="1250" Spacing="20" HorizontalAlignment="Left">
<Grid><StackPanel Spacing="5"><TextBlock Text="Good evening" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Bombi High School administration • local Windows records" Style="{StaticResource PageSubtitleStyle}"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock x:Name="DateText" HorizontalAlignment="Right" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="Local database" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Grid>
<Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="6"><TextBlock Text="Students" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="StudentsCount" Text="—" FontSize="30" FontWeight="Bold"/><TextBlock Text="Active records" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="6"><TextBlock Text="Subjects" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="SubjectsCount" Text="—" FontSize="30" FontWeight="Bold"/><TextBlock Text="Available subjects" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="6"><TextBlock Text="Results" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="ScoresCount" Text="—" FontSize="30" FontWeight="Bold"/><TextBlock Text="Stored score records" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
<Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel Spacing="6"><TextBlock Text="Database" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="DatabaseState" Text="Healthy" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/><TextBlock x:Name="BackupState" Text="Checking backup..." Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
</Grid>
<Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><Grid><TextBlock Text="Quick actions" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Ctrl+K for search" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><WrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10"><Button Content="＋ Add student" Click="AddStudent_Click"/><Button Content="📝 Enter scores" Click="Scores_Click"/><Button Content="📚 Manage subjects" Click="Subjects_Click"/><Button Content="🏆 Rankings" Click="Rankings_Click"/><Button Content="💾 Create backup" Click="Backup_Click"/><Button Content="⚙ Settings" Click="Settings_Click"/></WrapGrid></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Needs attention" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="AttentionText" Text="Checking records..." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><Button Content="Open student directory" Click="Students_Click" HorizontalAlignment="Left"/></StackPanel></Border>
</Grid>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="System status" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="✓ Local database is isolated from the website database." Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="✓ Native WinUI / C# / MVVM — no WebView wrapper." Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="✓ Backups and recovery are available from Settings." Foreground="{StaticResource SuccessBrush}"/><TextBlock x:Name="WarningText" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></ScrollViewer></Page>
