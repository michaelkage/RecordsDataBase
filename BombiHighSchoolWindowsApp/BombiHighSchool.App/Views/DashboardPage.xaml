<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BombiHighSchool.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F172A">
    <ScrollViewer Padding="32,28,32,40">
        <StackPanel MaxWidth="1100" Spacing="20" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Bombi High School records, running natively and stored locally on Windows." FontSize="14" Foreground="#94A3B8" />
            </StackPanel>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Students" FontSize="13" Foreground="#94A3B8" />
                        <TextBlock Text="Manage records" FontSize="22" FontWeight="SemiBold" Foreground="#818CF8" />
                        <TextBlock Text="Add, edit, search and delete students." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Local data" FontSize="13" Foreground="#94A3B8" />
                        <TextBlock Text="ApplicationData" FontSize="22" FontWeight="SemiBold" Foreground="#34D399" />
                        <TextBlock Text="Independent from the website database." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Architecture" FontSize="13" Foreground="#94A3B8" />
                        <TextBlock Text="Native WinUI" FontSize="22" FontWeight="SemiBold" Foreground="#FBBF24" />
                        <TextBlock Text="XAML + C# + MVVM. No WebView wrapper." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel Spacing="8">
                    <TextBlock Text="Students is ready" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Open Students from the left navigation to start building the local school database. The next native modules will sit on the same data layer." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
