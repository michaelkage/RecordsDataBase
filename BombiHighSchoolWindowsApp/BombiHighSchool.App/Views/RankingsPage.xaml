<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.RankingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
<ScrollViewer Padding="32,28,32,40"><Grid MaxWidth="1250" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><StackPanel Spacing="4"><TextBlock Text="Rankings" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Compare academic performance using locally stored student scores." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><ComboBox Width="220" HorizontalAlignment="Right" Header="Class" ItemsSource="{x:Bind ViewModel.Classes}" SelectedItem="{x:Bind ViewModel.ClassFilter, Mode=TwoWay}"/></Grid>
<Border Grid.Row="1" Style="{StaticResource InsetStyle}"><StackPanel Orientation="Horizontal" Spacing="10" Padding="4"><TextBlock Text="●" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Academic ranking" FontWeight="SemiBold"/><TextBlock Text="Results are calculated from recorded scores; use the class filter to narrow the view." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Grid.Row="2" Style="{StaticResource CardStyle}"><ListView ItemsSource="{x:Bind ViewModel.Rankings, Mode=OneWay}"><ListView.Header><Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="#" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="STUDENT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="2" Text="CLASS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="3" Text="SUBJECTS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="4" Text="AVERAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/></Grid></Border></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Position}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding ClassLevel}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="3" Text="{Binding SubjectsTaken}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="4" Text="{Binding Average}" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
</Grid></ScrollViewer></Page>