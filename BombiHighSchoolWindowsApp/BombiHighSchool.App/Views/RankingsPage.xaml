<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.RankingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><Grid Padding="32" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rankings" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Calculated from locally stored student scores." Foreground="#94A3B8"/></StackPanel><ComboBox Grid.Column="1" Header="Class" ItemsSource="{x:Bind ViewModel.Classes}" SelectedItem="{x:Bind ViewModel.ClassFilter, Mode=TwoWay}"/></Grid><ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rankings, Mode=OneWay}"><ListView.ItemTemplate><DataTemplate><Grid Padding="14"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Position}" FontSize="18" FontWeight="Bold" Foreground="#818CF8"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding ClassLevel}" Foreground="#94A3B8"/><TextBlock Grid.Column="3" Text="{Binding SubjectsTaken}" Foreground="#94A3B8"/><TextBlock Grid.Column="4" Text="{Binding Average}" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Page>
