<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.AdminAcademicPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><ScrollViewer Padding="32"><Grid ColumnSpacing="18" RowSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Grid.ColumnSpan="3"><TextBlock Text="Student academics" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Select a student, manage school-controlled enrollment, accounts and scores." Foreground="#94A3B8"/></StackPanel><Border Grid.Row="1" Background="#172033" CornerRadius="16" Padding="20"><StackPanel Spacing="12"><TextBlock Text="Student" FontSize="20" FontWeight="SemiBold"/><ComboBox ItemsSource="{x:Bind ViewModel.Students}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}" DisplayMemberPath="Name"/><TextBlock Text="Available subject" Foreground="#94A3B8"/><ComboBox ItemsSource="{x:Bind ViewModel.Subjects}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name"/><Button Content="Enroll selected subject" Command="{x:Bind ViewModel.EnrollCommand}"/><TextBlock Text="Account" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0"/><PasswordBox Header="New student password" PasswordChanged="ResetPassword_Changed"/><Button Content="Reset student password" Command="{x:Bind ViewModel.ResetStudentPasswordCommand}"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Disable account" Command="{x:Bind ViewModel.DisableStudentAccountCommand}"/><Button Grid.Column="1" Content="Enable account" Command="{x:Bind ViewModel.EnableStudentAccountCommand}"/></Grid></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Background="#172033" CornerRadius="16" Padding="20"><StackPanel Spacing="12"><TextBlock Text="Enrolled subjects" FontSize="20" FontWeight="SemiBold"/><ListView ItemsSource="{x:Bind ViewModel.EnrolledSubjects}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name" Height="280"/><Button Content="Remove selected" Command="{x:Bind ViewModel.RemoveCommand}"/></StackPanel></Border><Border Grid.Row="1" Grid.Column="2" Background="#172033" CornerRadius="16" Padding="20"><StackPanel Spacing="12"><TextBlock Text="Score entry" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Selected subject: {x:Bind ViewModel.SelectedSubject.Name, Mode=OneWay}" Foreground="#94A3B8"/><TextBox Header="CA / Test (0–40)" Text="{x:Bind ViewModel.CaText, Mode=TwoWay}" InputScope="Number"/><TextBox Header="Exam (0–60)" Text="{x:Bind ViewModel.ExamText, Mode=TwoWay}" InputScope="Number"/><TextBlock Text="{x:Bind ViewModel.Total, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="#818CF8"/><TextBlock Text="{x:Bind ViewModel.Grade, Mode=OneWay}" FontSize="18"/><Button Content="Save score" Command="{x:Bind ViewModel.SaveScoreCommand}"/><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border></Grid></ScrollViewer></Page>