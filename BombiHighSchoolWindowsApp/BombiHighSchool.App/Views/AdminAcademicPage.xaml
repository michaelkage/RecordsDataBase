<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.AdminAcademicPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}"><ScrollViewer Padding="32,28,32,40"><Grid MaxWidth="1450" ColumnSpacing="18" RowSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Grid.ColumnSpan="3" Spacing="4"><TextBlock Text="Student academics" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Manage enrollment, student accounts and individual results from one workspace." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Student &amp; account" Style="{StaticResource SectionTitleStyle}"/><ComboBox ItemsSource="{x:Bind ViewModel.Students}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}" DisplayMemberPath="Name" Header="Student"/><Border Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,2"/><TextBlock Text="Enrollment" FontWeight="SemiBold"/><ComboBox ItemsSource="{x:Bind ViewModel.Subjects}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name" Header="Available subject"/><Button Content="Enroll selected subject" Command="{x:Bind ViewModel.EnrollCommand}" Style="{StaticResource PrimaryButtonStyle}"/><TextBlock Text="Account" FontWeight="SemiBold" Margin="0,8,0,0"/><PasswordBox Header="New student password" PasswordChanged="ResetPassword_Changed"/><Button Content="Reset student password" Command="{x:Bind ViewModel.ResetStudentPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Disable account" Command="{x:Bind ViewModel.DisableStudentAccountCommand}" Style="{StaticResource DangerButtonStyle}"/><Button Grid.Column="1" Content="Enable account" Command="{x:Bind ViewModel.EnableStudentAccountCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Enrolled subjects" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Subjects currently linked to the selected student." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><ListView ItemsSource="{x:Bind ViewModel.EnrolledSubjects}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name" Height="300"/><Button Content="Remove selected" Command="{x:Bind ViewModel.RemoveCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border><Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Score entry" Style="{StaticResource SectionTitleStyle}"/><Border Style="{StaticResource InsetStyle}"><TextBlock Text="Selected subject: {x:Bind ViewModel.SelectedSubject.Name, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></Border><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="CA / Test (0–40)" Text="{x:Bind ViewModel.CaText, Mode=TwoWay}" InputScope="Number" PlaceholderText="0–40"/><TextBox Grid.Column="1" Header="Exam (0–60)" Text="{x:Bind ViewModel.ExamText, Mode=TwoWay}" InputScope="Number" PlaceholderText="0–60"/></Grid><Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="12" Padding="16"><StackPanel Spacing="3"><TextBlock Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.Total, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{x:Bind ViewModel.Grade, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/></StackPanel></Border><Button Content="Save score" Command="{x:Bind ViewModel.SaveScoreCommand}" Style="{StaticResource PrimaryButtonStyle}"/><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border></Grid></ScrollViewer></Page>