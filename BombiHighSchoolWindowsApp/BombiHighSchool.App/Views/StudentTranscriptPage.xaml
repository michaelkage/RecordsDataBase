<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.StudentTranscriptPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><Grid Padding="32" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Transcript" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Print your current academic record using the Windows print system." Foreground="#94A3B8"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="Print / Save as PDF" Click="Print_Click"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel></Grid><ScrollViewer Grid.Row="1"><Border x:Name="TranscriptSurface" Background="White" Padding="42" MaxWidth="820" HorizontalAlignment="Center"><StackPanel Spacing="14"><TextBlock Text="BOMBI HIGH SCHOOL" Foreground="#111827" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="ACADEMIC TRANSCRIPT" Foreground="#374151" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><Border Height="1" Background="#D1D5DB"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="Student" Foreground="#6B7280"/><TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Foreground="#111827" FontWeight="SemiBold"/><TextBlock Text="BHS ID: {x:Bind ViewModel.Id, Mode=OneWay}" Foreground="#374151"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Class" Foreground="#6B7280"/><TextBlock Text="{x:Bind ViewModel.Class, Mode=OneWay}" Foreground="#111827" FontWeight="SemiBold"/><TextBlock Text="Department: {x:Bind ViewModel.Department, Mode=OneWay}" Foreground="#374151"/></StackPanel></Grid><TextBlock Text="Results" Foreground="#111827" FontSize="18" FontWeight="SemiBold"/><ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="5"><Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Subject}" Foreground="#111827"/><TextBlock Grid.Column="1" Text="{Binding CA}" Foreground="#111827"/><TextBlock Grid.Column="2" Text="{Binding Exam}" Foreground="#111827"/><TextBlock Grid.Column="3" Text="{Binding Total}" Foreground="#111827" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="{Binding Grade}" Foreground="#111827" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Average: {x:Bind ViewModel.Average, Mode=OneWay}" Foreground="#111827" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#4B5563" TextWrapping="Wrap"/></StackPanel></Border></ScrollViewer></Grid></Page>
