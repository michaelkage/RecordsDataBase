<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
<ScrollViewer Padding="32,28,32,40"><StackPanel MaxWidth="1050" Spacing="20"><StackPanel Spacing="4"><TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Academic period, appearance, security, local data and recovery." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Academic period" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Scores and rankings are stored against the selected session and term." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBox Header="Academic session" Text="{x:Bind ViewModel.Session, Mode=TwoWay}" PlaceholderText="2026/2027"/><ComboBox Grid.Column="1" Header="Term" ItemsSource="{x:Bind ViewModel.Terms}" SelectedItem="{x:Bind ViewModel.Term, Mode=TwoWay}"/><Button Grid.Column="2" Content="Save period" Command="{x:Bind ViewModel.SaveAcademicPeriodCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/></Grid></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Theme" FontWeight="SemiBold"/><TextBlock Text="Choose how Bombi High School should look for this session." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ComboBox Grid.Column="1" x:Name="ThemePicker" SelectedIndex="0" SelectionChanged="ThemePicker_SelectionChanged"><ComboBoxItem Content="Use Windows setting"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></Grid></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Administrator password" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Update the local administrator password. Keep credentials private and use a strong password." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><PasswordBox Header="Current password" PasswordChanged="CurrentPassword_Changed"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><PasswordBox Header="New password" PasswordChanged="NewPassword_Changed"/><PasswordBox Grid.Column="1" Header="Confirm new password" PasswordChanged="ConfirmPassword_Changed"/></Grid><Button Content="Change administrator password" Command="{x:Bind ViewModel.ChangeAdminPasswordCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><Grid><StackPanel Spacing="4"><TextBlock Text="Database management" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="The Windows app database is local and independent from the website." Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><TextBlock Text="● Local storage" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Create backup" Command="{x:Bind ViewModel.CreateBackupCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="1" Content="Export database" Command="{x:Bind ViewModel.ExportDatabaseCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="2" Content="Import database" Command="{x:Bind ViewModel.ImportDatabaseCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid><Button Content="Restore latest backup" Command="{x:Bind ViewModel.RestoreBackupCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="10" Padding="12"><TextBlock Text="Restore and import preserve the current database before replacing it. Never close the app while an operation is running." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/></Border></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Ctrl + K    Search students and BHS IDs"/><TextBlock Text="Ctrl + N    New student"/><TextBlock Text="Ctrl + S    Save when a form supports it"/><TextBlock Text="Ctrl + P    Print transcript"/><TextBlock Text="F5          Refresh the current view" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left"/><Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="12" Padding="16"><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer></Page>