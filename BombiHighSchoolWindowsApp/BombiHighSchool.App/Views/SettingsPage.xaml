<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><ScrollViewer Padding="32"><StackPanel MaxWidth="900" Spacing="20"><StackPanel Spacing="5"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Local Windows application settings, security and database recovery." Foreground="#94A3B8"/></StackPanel><Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Administrator password" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="The administrator password is hashed in the local database. The built-in fail-safe is only used if the local administrator account cannot be found." Foreground="#94A3B8" TextWrapping="Wrap"/><PasswordBox Header="Current password" PasswordChanged="CurrentPassword_Changed"/><PasswordBox Header="New password" PasswordChanged="NewPassword_Changed"/><PasswordBox Header="Confirm new password" PasswordChanged="ConfirmPassword_Changed"/><Button Content="Change administrator password" Command="{x:Bind ViewModel.ChangeAdminPasswordCommand}" HorizontalAlignment="Left"/></StackPanel></Border><Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Database management" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="The Windows app keeps its own database in ApplicationData. Create backups before major changes. Importing or restoring also preserves a copy of the current database." Foreground="#94A3B8" TextWrapping="Wrap"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Create backup" Command="{x:Bind ViewModel.CreateBackupCommand}"/><Button Grid.Column="1" Content="Export database" Command="{x:Bind ViewModel.ExportDatabaseCommand}"/><Button Grid.Column="2" Content="Import database" Command="{x:Bind ViewModel.ImportDatabaseCommand}"/></Grid><Button Content="Restore latest backup" Command="{x:Bind ViewModel.RestoreBackupCommand}" HorizontalAlignment="Left"/><TextBlock Text="Restore replaces the active database with the latest backup and keeps a before-restore copy." Foreground="#F59E0B" TextWrapping="Wrap"/></StackPanel></Border><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left"/><Border Background="#172033" CornerRadius="12" Padding="16"><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer></Page>
