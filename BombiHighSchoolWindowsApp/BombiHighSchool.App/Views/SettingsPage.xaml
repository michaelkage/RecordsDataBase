<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="760" Spacing="20">
            <StackPanel Spacing="5"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Local Windows application settings and administrator security." Foreground="#94A3B8"/></StackPanel>
            <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="Administrator password" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="The password is hashed locally; it is never stored as plain text." Foreground="#94A3B8" TextWrapping="Wrap"/>
                    <PasswordBox Header="Current password" PasswordChanged="CurrentPassword_Changed"/>
                    <PasswordBox Header="New password" PasswordChanged="NewPassword_Changed"/>
                    <PasswordBox Header="Confirm new password" PasswordChanged="ConfirmPassword_Changed"/>
                    <Button Content="Change administrator password" Command="{x:Bind ViewModel.ChangeAdminPasswordCommand}" HorizontalAlignment="Left"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
