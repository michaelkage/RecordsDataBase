<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
    <Grid Padding="32">
        <Border MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="40">
            <StackPanel Spacing="22">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center"><TextBlock Text="B" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Bombi High School" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Academic Records System" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Height="1" Background="{StaticResource SurfaceBorderBrush}"/>
                <StackPanel Spacing="4"><TextBlock Text="Choose a portal" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="Select the workspace you want to open." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Click="Student_Click" Padding="20" HorizontalContentAlignment="Stretch" Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Contact"/><TextBlock Text="Student Portal" FontSize="18" FontWeight="SemiBold"/></StackPanel><TextBlock Text="View profile, subjects, scores and rankings." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="Admin_Click" Padding="20" HorizontalContentAlignment="Stretch" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Admin"/><TextBlock Text="Admin Portal" FontSize="18" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Manage students, subjects, scores and records." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                    </Button>
                </Grid>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Local-first records" Message="Data is stored locally on this Windows device."/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
