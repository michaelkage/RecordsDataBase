<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackgroundBrush}">
    <Grid Padding="32">
        <Border MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="18" Padding="44">
            <StackPanel Spacing="26">
                <StackPanel Spacing="7">
                    <TextBlock Text="Bombi High School" FontSize="36" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Academic Records System" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Height="1" Background="{StaticResource SurfaceBorderBrush}"/>
                <StackPanel Spacing="5">
                    <TextBlock Text="Choose a portal" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select where you want to go. You can return here at any time."
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Click="Student_Click" Padding="22" HorizontalContentAlignment="Stretch"
                            Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Student Portal" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="View your profile, subjects, scores and rankings." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="Admin_Click" Padding="22" HorizontalContentAlignment="Stretch"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Admin Portal" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Manage students, subjects, scores and school records." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="Local-first records" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Data is stored locally on this Windows device."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
