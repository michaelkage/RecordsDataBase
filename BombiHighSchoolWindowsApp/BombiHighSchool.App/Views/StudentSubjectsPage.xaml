<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.StudentSubjectsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><Grid Padding="32" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#172033" CornerRadius="16" Padding="20"><StackPanel Spacing="12"><TextBlock Text="Available subjects" FontSize="20" FontWeight="SemiBold"/><ListView ItemsSource="{x:Bind ViewModel.AvailableSubjects}" SelectedItem="{x:Bind ViewModel.SelectedAvailableSubject, Mode=TwoWay}" DisplayMemberPath="Name" Height="500"/><Button Content="Enroll selected" Command="{x:Bind ViewModel.EnrollCommand}"/></StackPanel></Border><Border Grid.Column="1" Background="#172033" CornerRadius="16" Padding="20"><StackPanel Spacing="12"><TextBlock Text="My subjects" FontSize="20" FontWeight="SemiBold"/><ListView ItemsSource="{x:Bind ViewModel.EnrolledSubjects}" SelectedItem="{x:Bind ViewModel.SelectedEnrolledSubject, Mode=TwoWay}" DisplayMemberPath="Name" Height="500"/><Button Content="Remove selected" Command="{x:Bind ViewModel.RemoveCommand}"/></StackPanel></Border><StackPanel Grid.Column="2" Width="240" Spacing="12"><TextBlock Text="Subjects" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Choose the subjects you are enrolled in. Compulsory subjects are managed by the school." Foreground="#94A3B8" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#818CF8" TextWrapping="Wrap"/></StackPanel></Grid></Page>