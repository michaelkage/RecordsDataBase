<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.StudentProfilePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A">
<ScrollViewer Padding="32"><StackPanel MaxWidth="1100" Spacing="18">
<Grid><StackPanel><TextBlock Text="Student Profile" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Your personal and academic information." Foreground="#94A3B8"/></StackPanel><Button Content="Export transcript" Command="{x:Bind ViewModel.ExportTranscriptCommand}" HorizontalAlignment="Right"/></Grid>
<Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel Spacing="14"><TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.Id, Mode=OneWay}" Foreground="#818CF8" FontFamily="Consolas"/><Grid ColumnSpacing="20" RowSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Class: {x:Bind ViewModel.Class, Mode=OneWay}"/><TextBlock Grid.Column="1" Text="Department: {x:Bind ViewModel.Department, Mode=OneWay}"/><TextBlock Grid.Column="2" Text="Average: {x:Bind ViewModel.Average, Mode=OneWay}"/></Grid></StackPanel></Border>
<Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#172033" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Personal details" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Admission number: {x:Bind ViewModel.AdmissionNumber, Mode=OneWay}"/><TextBlock Text="Parent / guardian: {x:Bind ViewModel.ParentName, Mode=OneWay}"/><TextBlock Text="Phone: {x:Bind ViewModel.ParentPhone, Mode=OneWay}"/><TextBlock Text="Email: {x:Bind ViewModel.Email, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="Address: {x:Bind ViewModel.Address, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="#172033" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Transcript" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Generate a local transcript file containing your current results." Foreground="#94A3B8" TextWrapping="Wrap"/><Button Content="Export transcript to Documents" Command="{x:Bind ViewModel.ExportTranscriptCommand}" HorizontalAlignment="Left"/></StackPanel></Border></Grid>
<Border Background="#172033" CornerRadius="12" Padding="16"><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" TextWrapping="Wrap"/></Border>
</StackPanel></ScrollViewer></Page>
