<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.StudentShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A">
<NavigationView x:Name="StudentNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged" Background="#0F172A" Foreground="#F8FAFC">
<NavigationView.PaneHeader><StackPanel Padding="8,16,8,12" Spacing="10"><Border Width="42" Height="42" CornerRadius="12" Background="#4F46E5"><TextBlock Text="B" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Spacing="2"><TextBlock Text="Bombi High School" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Student Portal" FontSize="11" Foreground="#94A3B8"/></StackPanel></StackPanel></NavigationView.PaneHeader>
<NavigationView.MenuItems>
<NavigationViewItem Content="Overview" Tag="Overview"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="My profile" Tag="Profile"><NavigationViewItem.Icon><SymbolIcon Symbol="Contact"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="My subjects" Tag="Subjects"><NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="My results" Tag="Results"><NavigationViewItem.Icon><SymbolIcon Symbol="Calculator"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Transcript" Tag="Transcript"><NavigationViewItem.Icon><SymbolIcon Symbol="Document"/></NavigationViewItem.Icon></NavigationViewItem>
</NavigationView.MenuItems>
<NavigationView.FooterMenuItems><NavigationViewItem Content="Sign out" Tag="Logout"><NavigationViewItem.Icon><SymbolIcon Symbol="Leave"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
<Frame x:Name="ContentFrame"/>
</NavigationView></Page>
