<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.StudentShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
<NavigationView x:Name="StudentNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged" Background="{StaticResource PageBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}">
<NavigationView.PaneHeader><StackPanel Padding="8,16,8,12" Spacing="10"><Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource AccentBrush}"><TextBlock Text="B" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Spacing="2"><TextBlock Text="Bombi High School" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Student Portal" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel></NavigationView.PaneHeader>
<NavigationView.MenuItems>
<NavigationViewItem Content="Overview" Tag="Overview" Icon="Home"/>
<NavigationViewItem Content="My profile" Tag="Profile" Icon="Contact"/>
<NavigationViewItem Content="My subjects" Tag="Subjects" Icon="Library"/>
<NavigationViewItem Content="My results" Tag="Results" Icon="Calculator"/>
<NavigationViewItem Content="Transcript" Tag="Transcript" Icon="Document"/>
</NavigationView.MenuItems>
<NavigationView.FooterMenuItems><NavigationViewItem Content="Sign out" Tag="Logout" Icon="LeaveChat"/></NavigationView.FooterMenuItems>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12"><Grid><StackPanel><TextBlock x:Name="WelcomeText" Text="Student Portal" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StudentIdText" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10"><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Sign out" Click="SignOut_Click"/></StackPanel></Grid></Border>
<Frame Grid.Row="1" x:Name="ContentFrame" NavigationCacheMode="Enabled"/>
<Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8"><Grid><TextBlock Text="● Your records are stored locally on this Windows device" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Bombi High School • Student Portal" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></Border>
</Grid></NavigationView></Page>
