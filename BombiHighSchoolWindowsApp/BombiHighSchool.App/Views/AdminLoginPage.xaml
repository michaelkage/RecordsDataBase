<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.AdminLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F172A">
    <Grid Padding="40">
        <Border MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="22" Padding="32">
            <StackPanel Spacing="16">
                <Button Content="← Back" Click="Back_Click" HorizontalAlignment="Left"/>
                <TextBlock Text="Administrator sign in" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Access the school records management portal." Foreground="#94A3B8" TextWrapping="Wrap"/>
                <TextBox Header="Username" Text="{x:Bind ViewModel.Username, Mode=TwoWay}"/>
                <PasswordBox Header="Password" PasswordChanged="Password_Changed"/>
                <Button Content="Sign in as administrator" Command="{x:Bind ViewModel.LoginCommand}" HorizontalAlignment="Stretch"/>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                <TextBlock Text="First-run local admin: admin / Admin@1234. Change this password in Settings." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
