<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.AdminLoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}"><Grid Padding="32"><Border MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardStyle}" Padding="36"><StackPanel Spacing="16"><Button Content="← Back" Click="Back_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><StackPanel Spacing="4"><TextBlock Text="Administrator sign in" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Access the school records management portal." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><Border Height="1" Background="{StaticResource SurfaceBorderBrush}"/><TextBox Header="Username" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" PlaceholderText="Administrator username"/><PasswordBox Header="Password" PasswordChanged="Password_Changed"/><Button Content="Sign in as administrator" Command="{x:Bind ViewModel.LoginCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"/><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/><Border Style="{StaticResource InsetStyle}"><TextBlock Text="For first-run setup, use the configured local administrator credentials and change the password immediately in Settings." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></Border></StackPanel></Border></Grid></Page>