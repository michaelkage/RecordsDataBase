<?xml version="1.0" encoding="utf-8"?>
<Page x:Name="PageRoot" x:Class="BombiHighSchool.App.Views.SubjectsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
    <ScrollViewer Padding="32,28,32,40"><Grid MaxWidth="1400" ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Create and maintain the subjects used across student records." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Border Height="1" Background="{StaticResource SurfaceBorderBrush}"/><TextBox Header="Subject name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" PlaceholderText="e.g. Mathematics"/><TextBox Header="Subject code" Text="{x:Bind ViewModel.Code, Mode=TwoWay}" PlaceholderText="e.g. MTH"/><ComboBox Header="Department" ItemsSource="{x:Bind ViewModel.Departments}" SelectedItem="{x:Bind ViewModel.Department, Mode=TwoWay}"/><CheckBox Content="Compulsory subject" IsChecked="{x:Bind ViewModel.IsCompulsory, Mode=TwoWay}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{x:Bind ViewModel.SaveText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid><Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12"><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></Border></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Spacing="3"><TextBlock Text="Subjects" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Manage the curriculum catalogue available to the school." Style="{StaticResource PageSubtitleStyle}"/></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource InsetStyle}"><StackPanel Orientation="Horizontal" Spacing="10" Padding="4"><TextBlock Text="●" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Curriculum catalogue" FontWeight="SemiBold"/><TextBlock Text="Use Edit to update an existing subject." Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border><ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}"><ListView.Header><Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CODE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="SUBJECT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="2" Text="DEPARTMENT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="3" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/></Grid></Border></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Department}" Foreground="{StaticResource TextSecondaryBrush}"/><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"><Button Content="Edit" Command="{Binding ElementName=PageRoot, Path=ViewModel.EditCommand}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="Delete" Command="{Binding ElementName=PageRoot, Path=ViewModel.DeleteCommand}" CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
    </Grid></ScrollViewer>
</Page>
