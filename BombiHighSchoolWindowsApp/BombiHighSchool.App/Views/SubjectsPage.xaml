<?xml version="1.0" encoding="utf-8"?><Page x:Name="PageRoot" x:Class="BombiHighSchool.App.Views.SubjectsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><Grid Padding="32" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#172033" CornerRadius="16" Padding="22"><StackPanel Spacing="14"><TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/><TextBox Header="Subject name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/><TextBox Header="Subject code" Text="{x:Bind ViewModel.Code, Mode=TwoWay}"/><ComboBox Header="Department" ItemsSource="{x:Bind ViewModel.Departments}" SelectedItem="{x:Bind ViewModel.Department, Mode=TwoWay}"/><CheckBox Content="Compulsory subject" IsChecked="{x:Bind ViewModel.IsCompulsory, Mode=TwoWay}"/><Button Content="{x:Bind ViewModel.SaveText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}"/><Button Content="Clear" Command="{x:Bind ViewModel.ClearCommand}"/><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="#172033" CornerRadius="16" Padding="22"><Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Subjects" FontSize="28" FontWeight="SemiBold"/><ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Subjects, Mode=OneWay}"><ListView.ItemTemplate><DataTemplate><Grid Padding="12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Code}" Foreground="#818CF8"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding Department}" Foreground="#94A3B8"/><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"><Button Content="Edit" Command="{Binding ElementName=PageRoot, Path=ViewModel.EditCommand}" CommandParameter="{Binding}"/><Button Content="Delete" Command="{Binding ElementName=PageRoot, Path=ViewModel.DeleteCommand}" CommandParameter="{Binding}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border></Grid></Page>
