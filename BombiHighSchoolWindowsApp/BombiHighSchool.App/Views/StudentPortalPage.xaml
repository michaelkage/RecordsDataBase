<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.StudentPortalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F172A">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="5">
                <TextBlock Text="Student Portal" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Your academic record, kept locally on this Windows device." Foreground="#94A3B8"/>
            </StackPanel>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22"><StackPanel Spacing="6"><TextBlock Text="Profile" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="View your class, department and personal details." Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="1" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22"><StackPanel Spacing="6"><TextBlock Text="Scores" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="View subjects, CA, exam, total and grades." Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="2" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22"><StackPanel Spacing="6"><TextBlock Text="Ranking" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="See your class and department performance." Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>
            <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Student account" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Student-specific data pages will be connected to the local Scores and Rankings services next." Foreground="#94A3B8" TextWrapping="Wrap"/>
                    <Button Content="Sign out" Click="SignOut_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
