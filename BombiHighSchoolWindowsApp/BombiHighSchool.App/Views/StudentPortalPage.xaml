<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.StudentPortalPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A">
<ScrollViewer Padding="32"><StackPanel MaxWidth="1200" HorizontalAlignment="Left" Spacing="20">
<StackPanel Spacing="5"><TextBlock Text="Student Portal" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Your academic record, subjects and rankings." Foreground="#94A3B8"/></StackPanel>
<Border Background="#172033" CornerRadius="16" Padding="24"><Grid ColumnSpacing="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ViewModel.StudentName, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.StudentId, Mode=OneWay}" Foreground="#818CF8"/><TextBlock Text="{x:Bind ViewModel.ClassLabel, Mode=OneWay}" Foreground="#94A3B8"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Overall average" Foreground="#94A3B8"/><TextBlock Text="{x:Bind ViewModel.AverageText, Mode=OneWay}" FontSize="32" FontWeight="Bold"/></StackPanel></Grid></Border>
<Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#172033" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="Class position" Foreground="#94A3B8"/><TextBlock Text="{x:Bind ViewModel.ClassPositionText, Mode=OneWay}" FontSize="22"/></StackPanel></Border><Border Grid.Column="1" Background="#172033" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="Department position" Foreground="#94A3B8"/><TextBlock Text="{x:Bind ViewModel.DepartmentPositionText, Mode=OneWay}" FontSize="22"/></StackPanel></Border><Border Grid.Column="2" Background="#172033" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="Subjects" Foreground="#94A3B8"/><TextBlock Text="{x:Bind ViewModel.Scores.Count, Mode=OneWay}" FontSize="22"/></StackPanel></Border></Grid>
<Border Background="#172033" CornerRadius="16" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Academic results" FontSize="20" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Subject" Foreground="#94A3B8"/><TextBlock Grid.Column="1" Text="CA" Foreground="#94A3B8"/><TextBlock Grid.Column="2" Text="Exam" Foreground="#94A3B8"/><TextBlock Grid.Column="3" Text="Total" Foreground="#94A3B8"/><TextBlock Grid.Column="4" Text="Grade" Foreground="#94A3B8"/></Grid><ListView ItemsSource="{x:Bind ViewModel.Scores, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding SubjectName}"/><TextBlock Grid.Column="1" Text="{Binding ContinuousAssessment}"/><TextBlock Grid.Column="2" Text="{Binding Exam}"/><TextBlock Grid.Column="3" Text="{Binding Total}" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="{Binding Grade}" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
<StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"/><Button Content="Sign out" Click="SignOut_Click"/></StackPanel><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Page>
