<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.StudentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A">
    <ScrollViewer Padding="32,28,32,40">
        <Grid MaxWidth="1450" HorizontalAlignment="Left" RowSpacing="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Spacing="5"><TextBlock Text="Students" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Manage complete student records locally on this Windows device." FontSize="14" Foreground="#94A3B8"/></StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="BHS ID is generated automatically." FontSize="11" Foreground="#94A3B8"/></StackPanel><Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.CancelEditCommand}"/></Grid>
                        <TextBox Header="Full name *" Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="Age *" Text="{x:Bind ViewModel.AgeText, Mode=TwoWay}" InputScope="Number"/><ComboBox Grid.Column="1" Header="Gender *" SelectedItem="{x:Bind ViewModel.Gender, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Genders}"/></Grid>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox Header="Class *" SelectedItem="{x:Bind ViewModel.ClassLevel, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.ClassLevels}"/><ComboBox Grid.Column="1" Header="Arm *" SelectedItem="{x:Bind ViewModel.Arm, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Arms}"/></Grid>
                        <ComboBox Header="Department" IsEnabled="{x:Bind ViewModel.IsSeniorClass, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Department, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Departments}"/>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="Admission number" Text="{x:Bind ViewModel.AdmissionNumber, Mode=TwoWay}"/><TextBox Grid.Column="1" Header="Date of birth" Text="{x:Bind ViewModel.DateOfBirth, Mode=TwoWay}" PlaceholderText="DD/MM/YYYY"/></Grid>
                        <TextBox Header="Parent / guardian name" Text="{x:Bind ViewModel.ParentName, Mode=TwoWay}"/><TextBox Header="Parent / guardian phone" Text="{x:Bind ViewModel.ParentPhone, Mode=TwoWay}"/><TextBox Header="Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}"/><TextBox Header="Address" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/><ComboBox Header="Status" SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Statuses}"/>
                        <Button Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Stretch"/><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center"/>
                    </StackPanel></ScrollViewer>
                </Border>
                <Border Grid.Column="1" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                    <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="Search by BHS ID, name, class, arm or department..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}"/></Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Students, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id}" FontFamily="Consolas" Foreground="#818CF8"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding Age}"/><TextBlock Grid.Column="3" Text="{Binding ClassLevel}"/><TextBlock Grid.Column="4" Text="{Binding Arm}"/><TextBlock Grid.Column="5" Text="{Binding Department}" Foreground="#94A3B8"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Edit selected" Command="{x:Bind ViewModel.EditCommand}" CommandParameter="{x:Bind ViewModel.SelectedStudent}"/><Button Grid.Column="2" Content="Delete selected" Command="{x:Bind ViewModel.DeleteCommand}" CommandParameter="{x:Bind ViewModel.SelectedStudent}"/></Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
