<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.StudentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}"><ScrollViewer Padding="32,28,32,40"><Grid MaxWidth="1450" HorizontalAlignment="Left" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Spacing="5"><TextBlock Text="Students" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Register students with only the core academic information. Complete optional details later when editing." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}"/><Button Content="New student" Click="NewStudent_Click"/></StackPanel></Grid><Grid Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="BHS ID and admission number are generated automatically." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.CancelEditCommand}"/></Grid><TextBox Header="Full name *" Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox Header="Gender *" SelectedItem="{x:Bind ViewModel.Gender, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Genders}"/><ComboBox Grid.Column="1" Header="Class *" SelectedItem="{x:Bind ViewModel.ClassLevel, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.ClassLevels}"/></Grid><ComboBox Header="Arm *" SelectedItem="{x:Bind ViewModel.Arm, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Arms}"/><ComboBox Header="Department *" IsEnabled="{x:Bind ViewModel.IsSeniorClass, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Department, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Departments}"/><StackPanel Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}Visibility" Spacing="10"><Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="10" Padding="12"><StackPanel Spacing="5"><TextBlock Text="Optional details" FontWeight="SemiBold"/><TextBlock Text="These fields are only relevant when editing an existing student." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="Age (optional)" Text="{x:Bind ViewModel.AgeText, Mode=TwoWay}" InputScope="Number" PlaceholderText="Leave blank if unknown"/><TextBox Grid.Column="1" Header="Date of birth (optional)" Text="{x:Bind ViewModel.DateOfBirth, Mode=TwoWay}" PlaceholderText="DD/MM/YYYY"/></Grid><TextBox Header="Admission number" Text="{x:Bind ViewModel.AdmissionNumber, Mode=TwoWay}" IsReadOnly="True"/><TextBox Header="Parent / guardian name (optional)" Text="{x:Bind ViewModel.ParentName, Mode=TwoWay}"/><TextBox Header="Parent / guardian phone (optional)" Text="{x:Bind ViewModel.ParentPhone, Mode=TwoWay}"/><TextBox Header="Email (optional)" Text="{x:Bind ViewModel.Email, Mode=TwoWay}"/><TextBox Header="Address (optional)" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/><ComboBox Header="Status" SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Statuses}"/></StackPanel><Button Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Stretch"/><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center"/></StackPanel></ScrollViewer></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="Search by BHS ID, name, class, arm or department..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}"/></Grid><ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Students, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id}" FontFamily="Consolas" Foreground="#818CF8"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding ClassLevel}"/><TextBlock Grid.Column="3" Text="{Binding Arm}"/><TextBlock Grid.Column="4" Text="{Binding Gender}"/><TextBlock Grid.Column="5" Text="{Binding Age}" Foreground="#94A3B8"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Edit selected" Command="{x:Bind ViewModel.EditCommand}" CommandParameter="{x:Bind ViewModel.SelectedStudent}"/><Button Grid.Column="2" Content="Archive selected" Click="ArchiveSelected_Click"/></Grid></Grid></Border></Grid></Grid></ScrollViewer></Page>
