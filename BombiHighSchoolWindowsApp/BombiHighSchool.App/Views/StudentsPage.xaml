<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BombiHighSchool.App.Views.StudentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F172A">

    <ScrollViewer Padding="32,28,32,40">
        <Grid MaxWidth="1280" HorizontalAlignment="Left" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="5">
                <TextBlock Text="Students" FontSize="30" FontWeight="SemiBold" Foreground="#F8FAFC" />
                <TextBlock Text="Add, search, edit and remove student records stored on this Windows device." FontSize="14" Foreground="#94A3B8" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="A unique BHS ID is generated automatically." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.CancelEditCommand}" />
                        </Grid>

                        <TextBox Header="Full name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" PlaceholderText="e.g. Michael Kage" />
                        <TextBox Header="Age" Text="{x:Bind ViewModel.AgeText, Mode=TwoWay}" PlaceholderText="e.g. 17" InputScope="Number" />

                        <ComboBox Header="Gender" SelectedItem="{x:Bind ViewModel.Gender, Mode=TwoWay}" PlaceholderText="Select gender">
                            <ComboBoxItem Content="Male" />
                            <ComboBoxItem Content="Female" />
                            <ComboBoxItem Content="Other" />
                        </ComboBox>

                        <ComboBox Header="Class" SelectedItem="{x:Bind ViewModel.ClassLevel, Mode=TwoWay}" PlaceholderText="Select class">
                            <ComboBoxItem Content="JSS1" />
                            <ComboBoxItem Content="JSS2" />
                            <ComboBoxItem Content="JSS3" />
                            <ComboBoxItem Content="SS1" />
                            <ComboBoxItem Content="SS2" />
                            <ComboBoxItem Content="SS3" />
                        </ComboBox>

                        <Button Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Stretch" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="Search by BHS ID, name, class or gender..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}" />
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Students, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}" SelectionMode="Single" BorderThickness="0">
                            <ListView.Header>
                                <Grid Padding="12,8" Background="#111827">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BHS ID" Foreground="#94A3B8" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="NAME" Foreground="#94A3B8" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="AGE" Foreground="#94A3B8" FontSize="11" />
                                    <TextBlock Grid.Column="3" Text="GENDER" Foreground="#94A3B8" FontSize="11" />
                                    <TextBlock Grid.Column="4" Text="CLASS" Foreground="#94A3B8" FontSize="11" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" FontFamily="Consolas" Foreground="#818CF8" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F8FAFC" />
                                        <TextBlock Grid.Column="2" Text="{Binding Age}" Foreground="#CBD5E1" />
                                        <TextBlock Grid.Column="3" Text="{Binding Gender}" Foreground="#CBD5E1" />
                                        <TextBlock Grid.Column="4" Text="{Binding ClassLevel}" Foreground="#CBD5E1" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Foreground="#94A3B8" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Edit selected" Command="{x:Bind ViewModel.EditCommand}" CommandParameter="{x:Bind ViewModel.SelectedStudent, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.SelectedStudent, Mode=OneWay}" />
                            <Button Grid.Column="2" Content="Delete selected" Command="{x:Bind ViewModel.DeleteCommand}" CommandParameter="{x:Bind ViewModel.SelectedStudent, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.SelectedStudent, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
