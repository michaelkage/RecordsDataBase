<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.StudentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
<ScrollViewer Padding="32,28,32,40"><Grid MaxWidth="1450" HorizontalAlignment="Left" RowSpacing="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><StackPanel Spacing="5"><TextBlock Text="Students" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Register, edit and manage student academic records." Style="{StaticResource PageSubtitleStyle}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="New student" Click="NewStudent_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid>
<Grid Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="500"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource CardStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="BHS ID and admission number are generated automatically." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.CancelEditCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
<Border Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,2,0,2"/>
<TextBox Header="Full name *" Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/>
<Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox Header="Gender *" SelectedItem="{x:Bind ViewModel.Gender, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Genders}"/><ComboBox Grid.Column="1" Header="Class *" SelectedItem="{x:Bind ViewModel.ClassLevel, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.ClassLevels}"/></Grid>
<Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox Header="Arm *" SelectedItem="{x:Bind ViewModel.Arm, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Arms}"/><ComboBox Grid.Column="1" Header="Department *" IsEnabled="{x:Bind ViewModel.IsSeniorClass, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Department, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Departments}"/></Grid>
<StackPanel Visibility="{x:Bind ViewModel.OptionalDetailsVisibility, Mode=OneWay}" Spacing="10"><Border Style="{StaticResource InsetStyle}"><StackPanel Spacing="5"><TextBlock Text="Optional details" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Add contact and profile details when editing an existing student." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
<Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="Age (optional)" Text="{x:Bind ViewModel.AgeText, Mode=TwoWay}" InputScope="Number" PlaceholderText="Leave blank if unknown"/><TextBox Grid.Column="1" Header="Date of birth (optional)" Text="{x:Bind ViewModel.DateOfBirth, Mode=TwoWay}" PlaceholderText="DD/MM/YYYY"/></Grid>
<TextBox Header="Admission number" Text="{x:Bind ViewModel.AdmissionNumber, Mode=TwoWay}" IsReadOnly="True"/><TextBox Header="Parent / guardian name (optional)" Text="{x:Bind ViewModel.ParentName, Mode=TwoWay}"/><TextBox Header="Parent / guardian phone (optional)" Text="{x:Bind ViewModel.ParentPhone, Mode=TwoWay}"/><TextBox Header="Email (optional)" Text="{x:Bind ViewModel.Email, Mode=TwoWay}"/><TextBox Header="Address (optional)" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/><ComboBox Header="Status" SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.Statuses}"/></StackPanel>
<Button Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"/><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center"/></StackPanel></ScrollViewer></Border>
<Border Grid.Column="1" Style="{StaticResource CardStyle}"><Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="Search by ID, name, class, arm or department..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
<TextBlock Grid.Row="1" Text="Select a student to edit or archive their record." Foreground="{StaticResource TextMutedBrush}" Margin="4,0"/>
<ListView Grid.Row="1" Margin="0,28,0,0" ItemsSource="{x:Bind ViewModel.Students, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,11"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding ClassLevel}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="3" Text="{Binding Arm}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="4" Text="{Binding Gender}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Grid.Column="5" Text="{Binding Age}" Foreground="{StaticResource TextMutedBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
<Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Edit selected" Command="{x:Bind ViewModel.EditCommand}" CommandParameter="{x:Bind ViewModel.SelectedStudent}" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="2" Content="Archive selected" Click="ArchiveSelected_Click" Style="{StaticResource DangerButtonStyle}"/></Grid>
</Grid></Border></Grid></Grid></ScrollViewer></Page>
