<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.ScoresPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
<ScrollViewer Padding="32,28,32,40"><StackPanel Spacing="20" MaxWidth="1200"><StackPanel Spacing="5"><TextBlock Text="Results" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Fast, validated score entry for the local academic record." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
<Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Enter result" Style="{StaticResource SectionTitleStyle}"/><ComboBox Header="Student" ItemsSource="{x:Bind ViewModel.Students}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}" DisplayMemberPath="Name"/><ComboBox Header="Subject" ItemsSource="{x:Bind ViewModel.Subjects}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="Test / CA (0–40)" Text="{x:Bind ViewModel.TestText, Mode=TwoWay}" InputScope="Number"/><TextBox Grid.Column="1" Header="Exam (0–60)" Text="{x:Bind ViewModel.ExamText, Mode=TwoWay}" InputScope="Number"/></Grid><Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16"><Grid><StackPanel><TextBlock Text="Total" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.CurrentTotal, Mode=OneWay}" FontSize="34" FontWeight="Bold"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="Grade" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/><TextBlock Text="{x:Bind ViewModel.CurrentGrade, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/></StackPanel></Grid></Border><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Save score" Command="{x:Bind ViewModel.SaveCommand}"/><Button Grid.Column="1" Content="Save &amp; next" Command="{x:Bind ViewModel.SaveAndNextCommand}"/><Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}"/></Grid><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center"/></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Score entry guide" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="1. Select a student."/><TextBlock Text="2. Select the subject they are already enrolled in."/><TextBlock Text="3. Enter CA/Test from 0 to 40 and Exam from 0 to 60."/><TextBlock Text="4. Review the calculated total and grade."/><TextBlock Text="5. Use Save &amp; next to move through a class quickly."/><Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Grading" FontWeight="SemiBold"/><TextBlock Text="A 75–100    B 70–74    C 60–69    D 50–59    E 45–49    F 0–44" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
</Grid></StackPanel></ScrollViewer></Page>
