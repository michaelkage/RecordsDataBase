<?xml version="1.0" encoding="utf-8"?><Page x:Class="BombiHighSchool.App.Views.ScoresPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0F172A"><Grid Padding="32" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#172033" CornerRadius="16" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Enter score" FontSize="22" FontWeight="SemiBold"/><ComboBox Header="Student" ItemsSource="{x:Bind ViewModel.Students}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}" DisplayMemberPath="Name"/><ComboBox Header="Subject" ItemsSource="{x:Bind ViewModel.Subjects}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name"/><TextBox Header="Test / CA (0–40)" Text="{x:Bind ViewModel.TestText, Mode=TwoWay}" InputScope="Number"/><TextBox Header="Exam (0–60)" Text="{x:Bind ViewModel.ExamText, Mode=TwoWay}" InputScope="Number"/><TextBlock Text="{x:Bind ViewModel.CurrentTotal, Mode=OneWay}" FontSize="34" FontWeight="Bold" Foreground="#818CF8"/><TextBlock Text="{x:Bind ViewModel.CurrentGrade, Mode=OneWay}" FontSize="18"/><Button Content="Save score" Command="{x:Bind ViewModel.SaveCommand}"/><TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="#172033" CornerRadius="16" Padding="22"><StackPanel Spacing="10"><TextBlock Text="Scores" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Scores are stored in the Windows app's local database and are independent from the website." Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border></Grid></Page>
