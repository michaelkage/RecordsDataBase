<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.Views.ScoresPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}">
<ScrollViewer Style="{StaticResource PageScrollStyle}"><StackPanel Spacing="18" MaxWidth="1250"><StackPanel Spacing="3"><TextBlock Text="Results" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Enter, review and save validated academic results." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
<Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><StackPanel Spacing="3"><TextBlock Text="Enter result" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Select the student and subject, then enter the two score components." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Border Height="1" Background="{StaticResource SurfaceBorderBrush}"/><ComboBox Header="Student *" ItemsSource="{x:Bind ViewModel.Students}" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}" DisplayMemberPath="Name"/><ComboBox Header="Subject *" ItemsSource="{x:Bind ViewModel.Subjects}" SelectedItem="{x:Bind ViewModel.SelectedSubject, Mode=TwoWay}" DisplayMemberPath="Name"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="Test / CA (0–40)" Text="{x:Bind ViewModel.TestText, Mode=TwoWay}" InputScope="Number" PlaceholderText="0–40"/><TextBox Grid.Column="1" Header="Exam (0–60)" Text="{x:Bind ViewModel.ExamText, Mode=TwoWay}" InputScope="Number" PlaceholderText="0–60"/></Grid><Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.CurrentTotal, Mode=OneWay}" FontSize="36" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="GRADE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/><TextBlock Text="{x:Bind ViewModel.CurrentGrade, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/></StackPanel></Grid></Border><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Save score" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Grid.Column="1" Content="Save &amp; next" Command="{x:Bind ViewModel.SaveAndNextCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" HorizontalAlignment="Center"/><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"/></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><StackPanel Spacing="3"><TextBlock Text="Score entry guide" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="A quick checklist to keep result entry consistent." Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Spacing="12"><StackPanel Spacing="3"><TextBlock Text="01  Select student" FontWeight="SemiBold"/><TextBlock Text="Choose the student whose result you are recording." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><StackPanel Spacing="3"><TextBlock Text="02  Select subject" FontWeight="SemiBold"/><TextBlock Text="Only record a result for the appropriate subject." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><StackPanel Spacing="3"><TextBlock Text="03  Enter scores" FontWeight="SemiBold"/><TextBlock Text="CA/Test is 0–40 and Exam is 0–60." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><StackPanel Spacing="3"><TextBlock Text="04  Review" FontWeight="SemiBold"/><TextBlock Text="Check the calculated total and grade before saving." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="5"><TextBlock Text="GRADING SCALE" FontWeight="SemiBold"/><TextBlock Text="A 75–100   B 70–74   C 60–69   D 50–59   E 45–49   F 0–44" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Border>
</Grid></StackPanel></ScrollViewer></Page>
