<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="BombiHighSchool.App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Background="#0F172A">
    <NavigationView x:Name="AppNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="Navigation_SelectionChanged" Background="#0F172A" Foreground="#F8FAFC">
        <NavigationView.PaneHeader>
            <StackPanel Padding="8,16,8,12" Spacing="10"><Border Width="42" Height="42" CornerRadius="12" Background="#4F46E5" HorizontalAlignment="Left"><TextBlock Text="B" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Spacing="2"><TextBlock Text="Bombi High School" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Windows Administration" FontSize="11" Foreground="#94A3B8"/></StackPanel></StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="Dashboard"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Students" Tag="Students"><NavigationViewItem.Icon><SymbolIcon Symbol="Contact"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Subjects" Tag="Subjects"><NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Scores" Tag="Scores"><NavigationViewItem.Icon><SymbolIcon Symbol="Calculator"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Rankings" Tag="Rankings"><NavigationViewItem.Icon><SymbolIcon Symbol="Sort"/></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Sign out" Tag="Logout"><NavigationViewItem.Icon><SymbolIcon Symbol="Leave"/></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame"/>
    </NavigationView>
</Page>
