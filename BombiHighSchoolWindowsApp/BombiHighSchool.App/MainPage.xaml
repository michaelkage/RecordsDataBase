<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}" KeyDown="MainPage_KeyDown">
    <NavigationView x:Name="AppNavigation"
                     IsSettingsVisible="False"
                     IsBackButtonVisible="Collapsed"
                     IsPaneToggleButtonVisible="True"
                     PaneDisplayMode="Left"
                     OpenPaneLength="248"
                     CompactPaneLength="48"
                     SelectionChanged="Navigation_SelectionChanged"
                     Background="{StaticResource SurfaceBrush}">
        <NavigationView.PaneHeader>
            <Grid Padding="12,18,12,14" ColumnSpacing="10">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="B" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Bombi High School" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Administration" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="Dashboard" ToolTipService.ToolTip="Dashboard">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Students" Tag="Students" ToolTipService.ToolTip="Student directory">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Contact"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Subjects" Tag="Subjects" ToolTipService.ToolTip="Subject catalogue">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Student academics" Tag="Academic" ToolTipService.ToolTip="Student academic records">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Scores" Tag="Scores" ToolTipService.ToolTip="Enter and review scores">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Calculator"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Rankings" Tag="Rankings" ToolTipService.ToolTip="Academic rankings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Up"/></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings" ToolTipService.ToolTip="Application settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Sign out" Tag="Logout" ToolTipService.ToolTip="Sign out">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Cancel"/></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Background="{StaticResource PageBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="GlobalSearchBox" PlaceholderText="Search students, subjects or BHS IDs" QuerySubmitted="GlobalSearch_QuerySubmitted" Width="500" HorizontalAlignment="Left">
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="K"/>
                        </AutoSuggestBox.KeyboardAccelerators>
                    </AutoSuggestBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="New student" Click="NewStudent_Click" Style="{StaticResource PrimaryButtonStyle}">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="N"/></Button.KeyboardAccelerators>
                        </Button>
                        <Button Content="Backup" Click="Backup_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame Grid.Row="1" x:Name="ContentFrame" NavigationCacheMode="Enabled" IsTabStop="False"/>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Local database ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="Bombi High School  •  Windows desktop app" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </NavigationView>
</Page>
