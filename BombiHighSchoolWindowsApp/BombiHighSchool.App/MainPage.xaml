<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BombiHighSchool.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0F172A">

    <Grid>
        <NavigationView
            x:Name="AppNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="Navigation_SelectionChanged"
            Background="#0F172A"
            Foreground="#F8FAFC">

            <NavigationView.PaneHeader>
                <StackPanel Padding="8,16,8,12" Spacing="10">
                    <Border
                        Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="#4F46E5"
                        HorizontalAlignment="Left">
                        <TextBlock
                            Text="B"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Bombi High School" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Windows Administration" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Students" Tag="Students">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Subjects" Tag="Subjects">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scores" Tag="Scores">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Calculator" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Rankings" Tag="Rankings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sort" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer Padding="32,28,32,40">
                <Grid MaxWidth="1280" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="{x:Bind ViewModel.CurrentSection, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="#F8FAFC" />
                        <TextBlock
                            Text="Manage your Bombi High School records locally on this Windows device."
                            FontSize="14"
                            Foreground="#94A3B8" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,28,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Students" FontSize="13" Foreground="#94A3B8" />
                                <TextBlock Text="{x:Bind ViewModel.StudentCount, Mode=OneWay}" FontSize="34" FontWeight="Bold" Foreground="#818CF8" />
                                <TextBlock Text="Stored locally" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Subjects" FontSize="13" Foreground="#94A3B8" />
                                <TextBlock Text="{x:Bind ViewModel.SubjectCount, Mode=OneWay}" FontSize="34" FontWeight="Bold" Foreground="#34D399" />
                                <TextBlock Text="Available to assign" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Data storage" FontSize="13" Foreground="#94A3B8" />
                                <TextBlock Text="Local" FontSize="28" FontWeight="Bold" Foreground="#FBBF24" />
                                <TextBlock Text="No website or WebView required" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,24,0,0" Background="#172033" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Local database" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="This Windows app has its own independent data store." FontSize="12" Foreground="#94A3B8" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.DatabaseLocation, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="{x:Bind ViewModel.StorageStatus, Mode=OneWay}" FontSize="12" Foreground="#34D399" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Margin="0,24,0,0" Background="#121B2D" BorderBrush="#26334A" BorderThickness="1" CornerRadius="16" Padding="22">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Native Windows foundation" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="The next screens will implement Students, Subjects, Scores, Rankings and Settings using WinUI controls and MVVM. The website remains the functional reference, but nothing here is rendered through a browser." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Page>
