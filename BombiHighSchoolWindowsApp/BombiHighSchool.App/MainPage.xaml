<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BombiHighSchool.App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackgroundBrush}" KeyDown="MainPage_KeyDown">
<Grid><NavigationView x:Name="AppNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="Navigation_SelectionChanged" Background="{StaticResource PageBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}">
<NavigationView.PaneHeader><StackPanel Padding="8,16,8,12" Spacing="10"><Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource AccentBrush}"><TextBlock Text="B" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Spacing="2"><TextBlock Text="Bombi High School" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Administration" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></StackPanel></NavigationView.PaneHeader>
<NavigationView.MenuItems>
<NavigationViewItem Content="Dashboard" Tag="Dashboard"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Students" Tag="Students"><NavigationViewItem.Icon><SymbolIcon Symbol="Contact"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Subjects" Tag="Subjects"><NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Student academics" Tag="Academic"><NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Scores" Tag="Scores"><NavigationViewItem.Icon><SymbolIcon Symbol="Calculator"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Rankings" Tag="Rankings"><NavigationViewItem.Icon><SymbolIcon Symbol="Up"/></NavigationViewItem.Icon></NavigationViewItem>
</NavigationView.MenuItems>
<NavigationView.FooterMenuItems><NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="Sign out" Tag="Logout"><NavigationViewItem.Icon><SymbolIcon Symbol="Cancel"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="GlobalSearchBox" PlaceholderText="Search students, subjects, BHS IDs...  (Ctrl+K)" QuerySubmitted="GlobalSearch_QuerySubmitted" Width="520" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button Content="New student" Click="NewStudent_Click"/><Button Content="Backup" Click="Backup_Click"/></StackPanel></Grid></Border><Frame Grid.Row="1" x:Name="ContentFrame"/><Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8"><Grid><TextBlock Text="● Local database ready" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Native WinUI • Local ApplicationData" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/></Grid></Border></Grid>
</NavigationView></Grid></Page>
