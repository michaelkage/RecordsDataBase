<Page x:Class="BombiHighSchool.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Existing application toolbar content remains unchanged. -->
        <Grid Grid.Row="0" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="GlobalSearchBox"
                            PlaceholderText="Search students, subjects, or actions"
                            QueryIcon="Find"
                            Width="420"
                            HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="New student" Click="NewStudent_Click" Style="{StaticResource PrimaryButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Content="Backup" Click="Backup_Click" Style="{StaticResource ToolbarButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- NavigationCacheMode belongs to Page, not Frame. Frame caching is controlled with CacheSize. -->
        <Frame Grid.Row="1" x:Name="ContentFrame" CacheSize="8" IsTabStop="False"/>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Local database ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
                <TextBlock Text="Bombi High School  •  Windows desktop app" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
