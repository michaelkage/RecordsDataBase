<Page x:Class="BombiHighSchool.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <NavigationView x:Name="AppNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left"
                        SelectionChanged="AppNavigation_SelectionChanged"
                        ItemInvoked="AppNavigation_ItemInvoked"
                        DisplayModeChanged="AppNavigation_DisplayModeChanged">
            <NavigationView.Header>
                <Grid Padding="24,16,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="GlobalSearchBox"
                                    PlaceholderText="Search students, subjects, or actions"
                                    QueryIcon="Find"
                                    Width="420"
                                    QuerySubmitted="GlobalSearchBox_QuerySubmitted">
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="K"/>
                        </AutoSuggestBox.KeyboardAccelerators>
                    </AutoSuggestBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="New student" Click="NewStudent_Click" Style="{StaticResource PrimaryButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="N"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Content="Backup" Click="Backup_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Students" Tag="students">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Subjects" Tag="subjects">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Academic" Tag="academic">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Education"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scores" Tag="scores">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Rankings" Tag="rankings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sort"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" CacheSize="8" IsTabStop="False"/>
        </NavigationView>
    </Grid>
</Page>
