<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="BombiHighSchool.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:BombiHighSchool_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Bombi High School design system. Neutral surfaces + school blue accent, with automatic light/dark support. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F7FB" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F5FF" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#DCE3EE" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#536176" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#7B879A" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E8F0FF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#16835B" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#A86600" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C73535" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0F141D" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#171E29" />
                    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#1C2532" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#253247" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#2B384B" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B1BDCE" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#7F8DA2" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#5B93F7" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AA9FF" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1D3154" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#45C995" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F2C45E" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF7777" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="InsetStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,9" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="13,7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
